# Shared server-only secret used by Hue HQ to request internal sign-cost fields.
# Use the same random 32+ character value in the pricing-engine and Hue HQ
# Vercel projects. Never prefix this value with NEXT_PUBLIC_.
HUE_PRICING_INTERNAL_API_SECRET=

# Shared published pricing. Enable only after migration 137, supplier validation,
# publication and coordinated deployment of HQ and the pricing app.
HQ_PRICING_BRIDGE_ENABLED=false
HQ_PRICING_BRIDGE_SECRET=
HQ_PRICING_BRIDGE_URL=https://hq.huegraphics.cc
